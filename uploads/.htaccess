Options -Indexes -ExecCGI

# In diesem Ordner liegen nur Fotos – Skripte werden nie ausgeführt
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
